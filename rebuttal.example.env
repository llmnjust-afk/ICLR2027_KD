# Optional manual configuration; the launcher can discover/download resources.
# Copy this file to rebuttal.local.env, then fill in the four local paths.
# DATA_ROOT must contain train/<WNID> and val/<WNID>.
DATA_ROOT=/path/to/imagenet100
REPORT_DIR=/path/to/imagenet100/val
DIT_CKPT=/path/to/DiT-XL-2-256x256.pt
VAE_PATH=/path/to/sd-vae-ft-mse

# Use a new experiment directory. Historical results are never overwritten.
WORKDIR=/home/lulm/ICLR2027_KD-main/results/rebuttal_v1
GPUS=0,1,2,3
ARCHITECTURES=convnet6
NCLASS=100
IPC=10
# CLASS_FILE=/home/lulm/ICLR2027_KD-main/misc/class100.txt
EPOCHS=2000
TUNE_GEN_SEEDS=0,1,2
FINAL_GEN_SEEDS=100,101,102,103,104
TRAIN_SEEDS=0,1,2
PERMUTATION_SEEDS=17,29,43
GEN_BATCH_SIZE=4
TRAIN_BATCH_SIZE=128
FEATURE_BATCH_SIZE=16
NUM_WORKERS=4
THREADS=4
FINAL_SUITE=full
CHECKPOINT_RULE=final
PRECISION=fp32
LOCAL_ONLY=1
DETERMINISTIC=0
# auto: Hub then curl fallback; curl: resumable HTTP/1.1 for large files.
REBUTTAL_DOWNLOAD_TRANSPORT=auto
REBUTTAL_DOWNLOAD_RETRIES=3
# Login node submission: bash scripts/submit_rebuttal.sh
# Defaults: one RTX 4090, 8 CPU cores, 32G RAM; cluster default account/QOS/time.
# REBUTTAL_GPU_COUNT=1
# REBUTTAL_SLURM_QOS=<your-authorized-qos>
# Optional: a torchvision ResNet-18 ImageNet state_dict for feature sensitivity.
# RESNET_FEATURE_CKPT=/path/to/resnet18-f37072fd.pth
